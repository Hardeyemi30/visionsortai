# Copy to .env and fill in. Never commit the real .env file.

# --- Thresholds (defaults shown; override only after calibrating on real photos) ---
DUPLICATE_HAMMING_THRESHOLD=8
BLUR_VARIANCE_THRESHOLD=100.0
EXPOSURE_CLIP_PCT_THRESHOLD=0.05
EXPOSURE_LUMINANCE_MIN=40.0
EXPOSURE_LUMINANCE_MAX=215.0
AGENT_CONFIDENCE_FLOOR=0.75

# --- exiftool ---
EXIFTOOL_BINARY=exiftool

# --- Azure OpenAI (vision agent) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Azure Storage ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=analyze-and-backup
AZURE_QUARANTINE_CONTAINER=quarantine
AZURE_DUPLICATES_CONTAINER=duplicates

# --- Azure Cosmos DB (shared with the teammate's api/ dashboard code) ---
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=visionsortai
AZURE_COSMOS_CONTAINER=photos

# --- Misc ---
SD_CARD_MOUNT_PATH=/media/pi/SD_CARD
LOCAL_BACKUP_DIR=./local_backup
